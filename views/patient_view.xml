<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <!-- Patient Tree View -->
    <record id="patient_tree_view" model="ir.ui.view">
        <field name="name">hms.patient.tree</field>
        <field name="model">hms.patient</field>

        <field name="arch" type="xml">
            <tree>
                <field name="first_name"/>
                <field name="last_name"/>
                <field name="age"/>
                <field name="blood_type"/>
                <field name="state"/>
            </tree>
        </field>
    </record>


    <!-- Patient Form View -->
    <record id="patient_form_view" model="ir.ui.view">
        <field name="name">hms.patient.form</field>
        <field name="model">hms.patient</field>

        <field name="arch" type="xml">
            <form>
                <sheet>

                    <group>
                        <field name="first_name" required="1"/>
                        <field name="last_name" required="1"/>
                        <field name="birth_date"/>
                        <field name="age"/>
                        <field name="email" required="1"/>
                    </group>

                    <group>
                        <field name="blood_type"/>
                        <field name="pcr"/>
                        <field name="cr_ratio"
                               required="pcr"/>
                        <field name="state"/>
                    </group>

                    <group>
                        <field name="department_id"
                               domain="[('is_opened','=',True)]"/>

                        <field name="department_capacity"
                               readonly="1"/>

                        <field name="doctor_ids"
                               widget="many2many_tags"
                               readonly="not department_id"
                               groups="hms.group_hms_manager"/>
                    </group>

                    <group>
                        <field name="address"/>

                        <field name="history"
                               invisible="age &lt; 50"/>
                    </group>

                    <group>
                        <field name="image"/>
                    </group>

                    <notebook>
                        <page string="Logs">
                            <field name="patient_log_ids" readonly="1">
                                <tree>
                                    <field name="created_by"/>
                                    <field name="date"/>
                                    <field name="description"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>


    <!-- Action -->
    <record id="patient_action" model="ir.actions.act_window">
        <field name="name">Patients</field>
        <field name="res_model">hms.patient</field>
        <field name="view_mode">tree,form</field>
    </record>


        <!-- Main Menu -->
        <menuitem id="hms_main_menu" name="HMS" sequence="10"/>

    <!-- Menu -->
    <menuitem
        id="patient_menu"
        name="Patients"
        parent="hms_main_menu"
        action="patient_action"/>

</odoo>